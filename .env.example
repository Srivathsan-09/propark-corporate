# ==========================================
# COMMUTEX - VERCEL ENVIRONMENT CONFIGURATION
# ==========================================

# 1. MongoDB Connection String (Use MongoDB Atlas URI for production)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/CommuteX?retryWrites=true&w=majority

# 2. NextAuth Configuration
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your_super_secret_jwt_encryption_key_here
# In Vercel, set to your production deployment URL (e.g. https://commutex.vercel.app)
NEXTAUTH_URL=https://your-domain.vercel.app

# 3. Google OAuth Provider Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 4. Environment
NODE_ENV=production

# 5. Vehicle RC Verification (Way2API)
# Official Documentation: https://www.way2api.com/page/service/vehicle-rc-verification
# Set mode to 'mock' for local development/testing, or 'real' for live API verification
RC_VERIFICATION_MODE=mock
RC_VERIFICATION_PROVIDER=way2api
RC_VERIFICATION_API_URL=https://app.way2api.com/api/v1/rc/verify
RC_VERIFICATION_API_KEY=your_way2api_api_key_here
